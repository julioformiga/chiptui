-/// Suspends the alternate screen and runs an interactive device monitor.
-fn run_monitor(
-    app: &mut App,
-    guard: &mut terminal::TerminalGuard,
-    pending: chiptui::app::PendingMonitor,
-) -> Result<()> {
-    let label = pending.command.to_string();
-    app.logs.info(format!("started {}", label));
-
-    let outcome = guard.suspend(|| {
-        std::process::Command::new(&pending.command.program)
-            .args(pending.command.args_slice())
-            .status()
-    })?;
-
-    match outcome {
-        Ok(status) if status.success() => {
-            app.logs.info(format!("{} closed", label));
-        }
-        Ok(status) => {
-            app.logs.warn(format!("{} exited with {}", label, status));
-        }
-        Err(source) => {
-            app.logs.error(format!("could not run {}: {}", label, source));
-        }
-    };
-
-    Ok(())
-}
