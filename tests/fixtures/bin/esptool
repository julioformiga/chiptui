#!/bin/sh
# Fake `esptool` for ChipTUI tests.
#
# Reproduces the output shapes of esptool v5.3.1's Click-based CLI (see
# src/backend/micropython/esptool/{commands,parse}.rs) so the flash flow can
# be exercised end to end without a board attached. `--port`/`--chip` are
# global options that may appear before the sub-command in either order, so
# matching is done by substring rather than a fixed argument shape.
#
# The `Features:` line is copied verbatim from an installed esptool v5.3.1's
# `targets/esp32.py::get_chip_features` --- `Wi-Fi` is hyphenated and `BT`
# never carries a version on a plain ESP32, both real esptool quirks a
# fabricated line got wrong once (`AGENTS.md`'s "reproduce the tool, not the
# belief about it").

args="$*"

case "$args" in
    *"--port /dev/ttyGONE"*)
        echo "A fatal error occurred: Could not open /dev/ttyGONE, the port is busy or doesn't exist" >&2
        exit 1
        ;;
esac

case "$args" in
    *"chip-id"*)
        printf 'esptool v5.3.1\n'
        printf 'Serial port /dev/ttyUSB0\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        printf 'Features: Wi-Fi, BT, Dual Core + LP Core, 240MHz, Coding Scheme None\n'
        printf 'Crystal is 40MHz\n'
        printf 'MAC: 24:6f:28:12:34:56\n'
        printf 'Chip ID: 0x1234567890ab\n'
        ;;

    *"flash-id"*)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        printf 'Features: Wi-Fi, BT, Dual Core + LP Core, 240MHz, Coding Scheme None\n'
        printf 'Crystal is 40MHz\n'
        printf 'MAC: 24:6f:28:12:34:56\n'
        printf 'Manufacturer: 5e\n'
        printf 'Device: 4016\n'
        printf 'Detected flash size: 4MB\n'
        ;;

    *"erase-flash"*)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        printf 'Erasing flash (this may take a while)...\n'
        printf 'Chip erase completed successfully\n'
        ;;

    *"write-flash"*)
        case "$args" in
            *"missing.bin"*)
                echo "esptool: [Errno 2] No such file or directory: 'missing.bin'" >&2
                exit 1
                ;;
        esac
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        printf 'Writing at 0x00001000... (50 %%)\r'
        printf 'Writing at 0x00001000... (100 %%)\r'
        printf '\n'
        printf 'Wrote 16384 bytes\n'
        printf 'Hash of data verified.\n'
        printf 'Hard resetting via RTS pin...\n'
        ;;

    *"verify-flash"*)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        printf 'Verifying 0x1000 (100 %%)\n'
        printf 'Verified OK!\n'
        ;;

    *"read-flash"*)
        # The firmware-identification probe: the "flash" it asked for is
        # written into the destination file (the last argument). ttyUSB0
        # answers like a MicroPython board, ttyUSB1 like one running Zephyr
        # (banner in the bootloader region, as on real hardware), ttyUSB2
        # like a plain ESP-IDF app, ttyUSB3 like a blank chip (erased
        # flash reads 0xFF everywhere --- 0x20000 bytes, the read's size),
        # and ttyUSB4 like a Zephyr *simple boot* board: the first window
        # identifies through the kernel's strings but the banner (and its
        # version) only exists at 0x6053c --- deep past the window, where
        # only the follow-up version hunt reads.
        dest=$(printf '%s\n' "$@" | tail -n 1)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32\n'
        printf 'Chip is ESP32-D0WD (revision 3)\n'
        case "$args" in
            *"--port /dev/ttyUSB1"*)
                printf '*** Booting Zephyr OS build v4.0.0 ***\n' > "$dest"
                ;;
            *"--port /dev/ttyUSB2"*)
                # The esp_app_desc magic word 0xABCD5432 (LE: 32 54 cd ab)
                # at its conventional spot 0x10028: app image at 0x10000,
                # image header 0x20, segment header 0x08. Then the
                # descriptor's own NUL-padded fixed-width fields: the
                # app's version (a project without a git tag is just `1`),
                # project_name, build time/date, and the IDF build's
                # version --- the one the Device info pane reports.
                head -c 65576 /dev/zero | tr '\000' '\377' > "$dest"
                printf '\062\124\315\253' >> "$dest"
                printf '\000\000\000\000' >> "$dest"
                printf '\000\000\000\000\000\000\000\000' >> "$dest"
                printf '1' >> "$dest";           head -c 31 /dev/zero >> "$dest"
                printf 'hello_world' >> "$dest"; head -c 21 /dev/zero >> "$dest"
                printf '10:30:00' >> "$dest";    head -c 8 /dev/zero >> "$dest"
                printf '2025-11-01' >> "$dest";  head -c 6 /dev/zero >> "$dest"
                printf 'v5.3.1' >> "$dest";      head -c 26 /dev/zero >> "$dest"
                ;;
            *"--port /dev/ttyUSB3"*)
                head -c 131072 /dev/zero | tr '\000' '\377' > "$dest"
                ;;
            *"--port /dev/ttyUSB4"*)
                # A simple-boot image: erased throughout except the
                # kernel's panic format at 0xa00 (what names the firmware
                # inside the identification window) and the boot banner at
                # 0x6053c (what dates it, reachable only by the hunt).
                img=$(mktemp "${TMPDIR:-/tmp}/chiptui-deep.XXXXXX")
                head -c 655360 /dev/zero | tr '\000' '\377' > "$img"
                printf '>>> ZEPHYR FATAL ERROR %%d: %%s on CPU %%d\n' \
                    | dd of="$img" bs=1 seek=2560 conv=notrunc status=none
                printf '*** Booting Zephyr OS build v4.4.0-11847-gc5dffcb7c9da ***\n' \
                    | dd of="$img" bs=1 seek=395068 conv=notrunc status=none
                case "$args" in
                    *"0x0 0x20000"*)
                        head -c 131072 "$img" > "$dest"
                        ;;
                    *"0x20000 0x80000"*)
                        tail -c +131073 "$img" | head -c 524288 > "$dest"
                        ;;
                esac
                rm -f "$img"
                ;;
            *)
                printf 'MicroPython v1.28.0 on 2025-11-01; ESP32 module with ESP32\n' > "$dest"
                ;;
        esac
        printf 'Read 131072 bytes\n'
        ;;

    *"run"*)
        printf 'esptool v5.3.1\n'
        printf 'Hard resetting via RTS pin...\n'
        ;;

    *)
        echo "A fatal error occurred: Could not open port, no device found" >&2
        exit 1
        ;;
esac
