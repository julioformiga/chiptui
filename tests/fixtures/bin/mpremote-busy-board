#!/bin/sh
# Fake `mpremote` for ChipTUI tests: a board whose `main.py` sits in a
# blocking loop and prints.
#
# Complements `mpremote` (the idle-board fake) for the busy-script paths:
# `repl` streams loop output with no `>>> ` prompt, so the startup probe
# must classify the board as running a script and hold device operations
# behind a confirmation instead of silently interrupting the loop.

args="$*"

case "$args" in
    "connect "*) args=$(printf '%s' "$args" | cut -d' ' -f3-) ;;
esac

case "$args" in
    devs)
        printf '/dev/ttyACM0 e6614104036e5f24 2e8a:0005 MicroPython Board in FS mode\n'
        ;;

    repl)
        # A blocking loop that talks: no banner, no prompt --- exactly what
        # the real board shows when main.py never returns. The first burst
        # lands before anything else so the probe can classify the board
        # immediately; a background printer keeps the output flowing after
        # it, and the foreground loop watches for ctrl-] (0x1d), mpremote
        # repl's own escape, to shut everything down when the probe closes
        # the session.
        printf 'loop: tick\nloop: tick\nloop: tick\n'
        ( while :; do printf 'loop: tick\n'; sleep 0.05; done ) &
        printer=$!
        stty raw -echo
        while [ "$(dd bs=1 count=1 2>/dev/null | od -An -tuC | tr -d ' \n')" != "29" ]; do :; done
        stty sane
        kill $printer 2>/dev/null
        ;;

    "fs --no-verbose ls :/")
        printf '%12d %s\n' 1024 'main.py'
        ;;

    "fs --no-verbose ls :/lib")
        # A board with main.py and nothing installed: no /lib exists yet.
        # Real mpremote reports ENOENT for it (the main fake's `ls
        # :/missing` documents the exact wording), never "no device found".
        echo 'mpremote: ls: No such file or directory.' >&2
        exit 1
        ;;

    "fs --no-verbose sha256sum :/main.py")
        # The Project pane's boot-file report hashes what both sides hold at
        # the same size. This board's main.py is not the project's.
        printf '1111111111111111111111111111111111111111111111111111111111111111\n'
        ;;

    "fs --no-verbose sha256sum :"*)
        # Anything else: this board does not have it. Real mpremote turns the
        # remote OSError into a CommandError naming the sub-command (see the
        # main fake's `ls :/missing`), never "no device found" --- a fake that
        # answered otherwise would hide a wrong path behind a plausible error.
        echo 'mpremote: sha256sum: No such file or directory.' >&2
        exit 1
        ;;

    df)
        printf '%s\n' 'filesystem     size     used    avail use% mounted on'
        printf '%s %9d %8d %8d %4d %s\n' 'vfs       ' 524288 262144 262144 50 '/'
        ;;

    reset)
        ;;

    "exec --no-follow import main")
        ;;

    *)
        echo "mpremote: no device found" >&2
        exit 1
        ;;
esac
