#!/bin/sh
# Fake `west build` that streams a ninja-style step counter with a pause
# between lines, so a test can catch the panel mid-build and see progress
# parsed out of real streamed output (`src/progress.rs`,
# `tests/build_view.rs`'s progress test) --- not just fed a canned string.
[ "$1" = "build" ] || {
    echo "west-progress: expected 'west build ...', got: $*" >&2
    exit 64
}
printf -- '-- Configuring done\n'
sleep 0.2
printf '[1/3] Building C object CMakeFiles/app.dir/main.c.obj\n'
sleep 0.2
printf '[2/3] Building C object CMakeFiles/app.dir/other.c.obj\n'
sleep 0.2
printf '[3/3] Linking C executable zephyr.elf\n'
exit 0
