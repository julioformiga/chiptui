#!/bin/sh
# Fake `mpremote` whose board has nested directories, so tests can exercise
# ascend/enter round trips where the left directory is not the first row
# (see tests/fixtures/bin/mpremote for the populated-board counterpart).

args="$*"

case "$args" in
    "connect "*) args=$(printf '%s' "$args" | cut -d' ' -f3-) ;;
esac

case "$args" in
    "fs --no-verbose ls :/")
        # Directories first: apps/, lib/, then files.
        printf '%12d %s\n' 0 'apps/'
        printf '%12d %s\n' 0 'lib/'
        printf '%12d %s\n' 16 'readme.py'
        ;;

    "fs --no-verbose ls :/apps")
        # Two subdirectories, so the one tests descend into (utils/) sits
        # below row 0.
        printf '%12d %s\n' 0 'tools/'
        printf '%12d %s\n' 0 'utils/'
        printf '%12d %s\n' 32 'main.py'
        ;;

    "fs --no-verbose ls :/apps/utils")
        printf '%12d %s\n' 64 'helpers.py'
        ;;

    "fs --no-verbose ls :/apps/tools")
        printf '%12d %s\n' 8 'tiny.py'
        ;;

    "fs --no-verbose ls :/lib")
        printf '%12d %s\n' 512 'simple.py'
        ;;

    df)
        printf '%s\n' 'filesystem     size     used    avail use% mounted on'
        printf '%s %9d %8d %8d %4d %s\n' 'vfs       ' 1048576 524288 524288 50 '/'
        ;;

    *)
        echo "mpremote: no device found" >&2
        exit 1
        ;;
esac
