#!/bin/sh
# Fake `scripts/footprint/size_report` for ChipTUI tests.
#
# It stands in for the *interpreter*, because that is what the command names:
# `<venv>/bin/python <zephyr_base>/scripts/footprint/size_report …`, and the
# build panel's `tool_path` seam overrides the program. So `$1` is the script
# path and everything after it is the script's own argument line.
#
# Per AGENTS.md, a fake reproduces the tool rather than the belief about it,
# and **rejects the wrong forms** so reintroducing one breaks a test. The
# real script builds its parser with `allow_abbrev=False` and marks `-k`,
# `-z` and `-o/--output` `required=True`; the target words are an argparse
# `choices` set; `--json` takes ONE path containing the literal
# `{target}`, which the script substitutes itself; and
# `--filter-address-range` takes TWO arguments (START LENGTH, `int(x, 0)`)
# and switches the run to one region's report --- the form
# `dashboard.py::_create_memory_reports` uses, where the `--json` path names
# the region outright and the single target is `all`.
script=$1
shift
case "$script" in
    */scripts/footprint/size_report) ;;
    *)
        printf 'fake size_report: expected the footprint script, got %s\n' "$script" >&2
        exit 2
        ;;
esac

kernel=
zephyrbase=
workspace=
json=
output=
targets=
range=

while [ $# -gt 0 ]; do
    case "$1" in
        -k|--kernel) kernel=$2; shift 2 ;;
        -z|--zephyrbase) zephyrbase=$2; shift 2 ;;
        -o|--output) output=$2; shift 2 ;;
        --workspace) workspace=$2; shift 2 ;;
        --workspace=*) workspace=${1#--workspace=}; shift ;;
        --json) json=$2; shift 2 ;;
        --filter-address-range) range="$2 $3"; shift 3 ;;
        -q|--quiet) shift ;;
        rom|ram|all) targets="$targets $1"; shift ;;
        -*)
            # `allow_abbrev=False`: an abbreviation is an unknown flag, and
            # argparse exits 2 for one.
            printf 'fake size_report: unrecognized argument %s\n' "$1" >&2
            exit 2
            ;;
        *)
            printf "fake size_report: '%s' is not one of 'rom', 'ram', 'all'\n" "$1" >&2
            exit 2
            ;;
    esac
done

[ -n "$kernel" ] || { printf 'fake size_report: -k is required\n' >&2; exit 2; }
[ -n "$zephyrbase" ] || { printf 'fake size_report: -z is required\n' >&2; exit 2; }
[ -n "$output" ] || { printf 'fake size_report: -o/--output is required\n' >&2; exit 2; }
[ -n "$targets" ] || { printf 'fake size_report: at least one target is required\n' >&2; exit 2; }

# `assert os.path.exists(args.kernel)` --- the real script dies here too.
[ -f "$kernel" ] || { printf 'fake size_report: %s does not exist\n' "$kernel" >&2; exit 1; }

if [ -z "$json" ]; then
    printf 'fake size_report: this fake only covers the --json path\n' >&2
    exit 2
fi

# The region form: one range, one target, a json path naming the region with
# no `{target}` left in it. The main form is everything else.
if [ -n "$range" ]; then
    [ "$targets" = " all" ] || {
        printf 'fake size_report: a filtered run targets all alone, got%s\n' "$targets" >&2
        exit 2
    }
    case "$json" in
        *'{target}'*)
            printf 'fake size_report: a filtered run names its region in --json, not {target}: %s\n' "$json" >&2
            exit 2
            ;;
    esac
    region=$(basename "$json" _report.json)
    # The real script opens this path with a plain `open(out, "w")` and
    # creates no parent, so a missing directory is a FileNotFoundError
    # traceback --- after the whole DWARF walk. Creating it here would hide
    # exactly that from the suite, so the fake refuses the same way.
    dir=$(dirname "$json")
    [ -d "$dir" ] || {
        printf 'fake size_report: [Errno 2] No such file or directory: %s\n' "$json" >&2
        exit 1
    }
    cat > "$json" <<JSON
{
  "symbols": {
    "name": "Root", "size": 300, "identifier": "root", "loc": [],
    "children": [
      { "name": "$region", "size": 300, "identifier": "$region", "loc": [],
        "children": [
          { "name": "heap_$region", "size": 200, "identifier": "$region/heap",
            "loc": ["all"], "address": 16, "section": ".bss" },
          { "name": "stack_$region", "size": 100, "identifier": "$region/stack",
            "loc": ["all"], "address": 32, "section": ".bss" }
        ] }
    ]
  },
  "total_size": 600
}
JSON
    printf 'size_report: region %s range %s\n' "$region" "$range"
    printf 'wrote %s\n' "$json"
    exit 0
fi

case "$json" in
    *'{target}'*) ;;
    *)
        printf 'fake size_report: --json must carry the literal {target}, got %s\n' "$json" >&2
        exit 2
        ;;
esac

printf 'size_report: workspace=%s\n' "$workspace"
for target in $targets; do
    out=$(printf '%s' "$json" | sed "s/{target}/$target/")
    # The real script opens this path with a plain `open(out, "w")` and
    # creates no parent, so a missing directory is a FileNotFoundError
    # traceback --- after the whole DWARF walk. Creating it here would hide
    # exactly that from the suite, so the fake refuses the same way.
    dir=$(dirname "$out")
    [ -d "$dir" ] || {
        printf 'fake size_report: [Errno 2] No such file or directory: %s\n' "$out" >&2
        exit 1
    }
    cat > "$out" <<JSON
{
  "symbols": {
    "name": "Root", "size": 300, "identifier": "root", "loc": [],
    "children": [
      { "name": "kernel", "size": 300, "identifier": "kernel", "loc": [],
        "children": [
          { "name": "heap_$target", "size": 200, "identifier": "kernel/heap_$target",
            "loc": ["$target"], "address": 16, "section": ".bss" },
          { "name": "stack_$target", "size": 100, "identifier": "kernel/stack_$target",
            "loc": ["$target"], "address": 32, "section": ".bss" }
        ] }
    ]
  },
  "total_size": 600
}
JSON
    printf 'wrote %s\n' "$out"
done
exit 0
