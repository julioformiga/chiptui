#!/bin/sh
# Fake `esptool` for a Zephyr *simple boot* board whose banner never lands
# inside either read window: `chip-id` answers like any ESP32, the
# identification window (`read-flash 0x0 0x20000`) carries only the kernel's
# panic-format string (enough to name Zephyr, never enough to date it), and
# the version-hunt window (`read-flash 0x20000 0x100000`) comes back blank
# --- so the flash-byte hunt fallback genuinely finds nothing too, which is
# what makes this fixture useful for testing the live boot-banner capture:
# any version that shows up came from the live capture, not from flash.

case "$*" in
    *"chip-id"*)
        printf 'esptool v5.3.1\n'
        printf 'Serial port /dev/ttyACM0\n'
        printf 'Detecting chip type... ESP32-C3\n'
        printf 'Chip is ESP32-C3 (revision 3)\n'
        printf 'Features: WiFi, BLE\n'
        printf 'Crystal is 40MHz\n'
        printf 'MAC: 24:6f:28:12:34:56\n'
        printf 'Chip ID: 0x1234567890ab\n'
        ;;

    *"read-flash 0x0 0x20000"*)
        dest=$(printf '%s\n' "$@" | tail -n 1)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32-C3\n'
        printf 'Chip is ESP32-C3 (revision 3)\n'
        head -c 131072 /dev/zero | tr '\000' '\377' > "$dest"
        printf '>>> ZEPHYR FATAL ERROR %%d: %%s on CPU %%d\n' \
            | dd of="$dest" bs=1 seek=2560 conv=notrunc status=none
        printf 'Read 131072 bytes\n'
        ;;

    *"read-flash 0x20000 0x100000"*)
        dest=$(printf '%s\n' "$@" | tail -n 1)
        printf 'esptool v5.3.1\n'
        printf 'Detecting chip type... ESP32-C3\n'
        printf 'Chip is ESP32-C3 (revision 3)\n'
        head -c 1048576 /dev/zero | tr '\000' '\377' > "$dest"
        printf 'Read 1048576 bytes\n'
        ;;

    *)
        echo "A fatal error occurred: Could not open port, no device found" >&2
        exit 1
        ;;
esac
